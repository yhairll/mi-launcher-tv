<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/qs_panel_bg"
        android:padding="20dp">

        <!-- Fecha, hora, ajustes y perfil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEE d 'de' MMM"
                    android:format24Hour="EEE d 'de' MMM"
                    android:textColor="#C9D1DC"
                    android:textSize="13sp" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="hh:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/qsGear"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:focusable="true"
                android:background="@drawable/qs_gear_bg"
                android:src="@drawable/ic_settings" />

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:background="@drawable/profile_circle"
                android:text="@string/profile_letter"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Mosaicos (se llenan desde el codigo) -->
        <LinearLayout
            android:id="@+id/qsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical" />

        <!-- Opciones para desarrolladores (solo si estan habilitadas) -->
        <LinearLayout
            android:id="@+id/qsDev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="true"
            android:background="@drawable/qs_tile_bg"
            android:padding="16dp">

            <ImageView
                android:id="@+id/qsDevIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_qs_dev" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/qsDevTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Se habilitaron las opciones para desarrolladores"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/qsDevSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Configuración avanzada del sistema disponible"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Pie -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mi TV"
                android:textColor="#C9D1DC"
                android:textSize="13sp" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:alpha="0.7"
                android:src="@drawable/ic_qs_help" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
