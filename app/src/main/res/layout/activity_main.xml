<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- IMAGEN DEL DESTACADO (arriba a la derecha). Pon tu imagen en android:src -->
    <FrameLayout
        android:layout_width="640dp"
        android:layout_height="340dp"
        android:layout_gravity="top|end">

        <ImageView
            android:id="@+id/heroImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/hero_placeholder" />

        <View
            android:layout_width="360dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@drawable/scrim_left" />

        <View
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="16dp">

        <!-- BARRA SUPERIOR: buscar, pestañas, iconos y reloj -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/search"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="14dp"
                android:focusable="true"
                android:background="@drawable/pill_focus_bg">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/search"
                    android:textColor="@color/tab_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tabHome"
                style="@style/Tab"
                android:layout_marginStart="14dp"
                android:text="@string/tab_home" />

            <TextView
                android:id="@+id/tabLive"
                style="@style/Tab"
                android:text="@string/tab_live" />

            <TextView
                android:id="@+id/tabShop"
                style="@style/Tab"
                android:text="@string/tab_shop" />

            <TextView
                android:id="@+id/tabApps"
                style="@style/Tab"
                android:text="@string/tab_apps" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/iconBell"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:focusable="true"
                android:background="@drawable/icon_focus_bg"
                android:src="@drawable/ic_bell" />

            <ImageView
                android:id="@+id/iconSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:focusable="true"
                android:background="@drawable/icon_focus_bg"
                android:src="@drawable/ic_settings" />

            <TextView
                android:id="@+id/profile"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:focusable="true"
                android:background="@drawable/profile_circle"
                android:text="@string/profile_letter"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:format12Hour="hh:mm"
                android:format24Hour="HH:mm"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- TEXTO DEL DESTACADO -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hero_label"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/hero_title"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/hero_subtitle"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxWidth="420dp"
                android:text="@string/hero_description"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- APPS FAVORITAS -->
        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/favorites"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appsRow"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="2dp"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <!-- BOTONES DE CATEGORIAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipLive"
                style="@style/Chip"
                android:text="@string/chip_live" />

            <TextView
                android:id="@+id/chipTop"
                style="@style/Chip"
                android:text="@string/chip_top" />

            <TextView
                android:id="@+id/chipPopular"
                style="@style/Chip"
                android:text="@string/chip_popular" />

            <TextView
                android:id="@+id/chipTrending"
                style="@style/Chip"
                android:text="@string/chip_trending" />
        </LinearLayout>

        <!-- FILA DE TARJETAS (se corta abajo, como en Android TV) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/row_for_you"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <HorizontalScrollView
            android:id="@+id/cardsScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/cardsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp" />
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
